{
  "name": "@countrystatecity/translations",
  "version": "2.1.2",
  "description": "Country name translations in 19 languages \u2014 Arabic, German, French, Spanish, and more",
  "keywords": [
    "country-state-city",
    "translations",
    "i18n",
    "localization",
    "country-names",
    "multilingual",
    "typescript",
    "lazy-loading"
  ],
  "author": "dr5hn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitty-crow/countrystatecity.git"
  },
  "homepage": "https://github.com/kitty-crow/countrystatecity/tree/main/packages/translations#readme",
  "bugs": {
    "url": "https://github.com/kitty-crow/countrystatecity/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data/*": "./dist/data/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:compat": "vitest run compatibility",
    "typecheck": "tsc --noEmit",
    "generate-data": "tsx ../../src/translations/scripts/generate-data.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "tsx": "^4.23.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
